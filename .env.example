# Choose ONE connection method. For an internal model, put its name:tag in
# OPENROUTER_MODEL and set INTERNAL_API_URL. Keep the external key empty.
OPENROUTER_MODEL=
OPENROUTER_API_KEY=
INTERNAL_API_URL=
